# Copia este archivo como .env.local y completa los valores. .env.local no se sube a git.

# Neon > Connection string (incluye la contraseña)
DATABASE_URL=postgresql://usuario:clave@host.neon.tech/neondb?sslmode=require

# Neon Auth > Configuration. Son públicas: el navegador las usa.
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=

# Resend > API Keys (recordatorios por email)
RESEND_API_KEY=
# Hasta verificar un dominio en Resend, usa onboarding@resend.dev (solo envía a tu propio email)
REMINDER_FROM=Apliko <onboarding@resend.dev>

# Cualquier texto largo y aleatorio; protege /api/recordatorios. Vercel lo envía solo en los cron jobs.
CRON_SECRET=
# URL pública del sitio para los enlaces del email (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

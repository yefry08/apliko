# Copia este archivo como .env.local y completa los valores. .env.local no se sube a git.

# Neon > Connection string (incluye la contraseña)
DATABASE_URL=postgresql://usuario:clave@host.neon.tech/neondb?sslmode=require

# Neon Auth > Configuration. Son públicas: el navegador las usa.
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=

# Super admin (lib/roles.ts): la cuenta con este email, ya verificado, ve /admin y nombra o quita admins.
SUPERADMIN_EMAIL=

# Cloudflare Turnstile (gratis), el "no soy un robot" de los formularios de cuenta.
# Cloudflare > Turnstile > Add widget. Sin estas dos, los formularios funcionan sin la verificación.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Correos de asesorías desde Gmail (lib/correo.ts). La contraseña es una contraseña de aplicación de Google
# (myaccount.google.com/apppasswords), no la normal. Sin estas dos, las reservas funcionan sin avisos.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Protege el cron diario de recordatorios (vercel.json). Cualquier texto largo y aleatorio.
CRON_SECRET=


# Escena de Spline del hero (solo en pantallas grandes). Sin definir usa la escena por defecto del código;
# vacía usa solo la escena 3D propia.
# NEXT_PUBLIC_SPLINE_SCENE=https://prod.spline.design/.../scene.splinecode
